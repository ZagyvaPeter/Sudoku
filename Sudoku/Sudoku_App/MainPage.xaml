<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Sudoku_App.MainPage"
             BackgroundColor="#121428">

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="20">

        <!-- Phone mockup container -->
        <Frame Grid.Row="1" 
               Grid.RowSpan="5"
               CornerRadius="40"
               Padding="0"
               HasShadow="True"
               BackgroundColor="#121428"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               WidthRequest="400"
               MaximumWidthRequest="500"
               Margin="0,0,0,20">
            
            <Grid RowDefinitions="60,Auto,*,Auto,Auto" Padding="15">
                
                <!-- Header Bar -->
                <Grid Grid.Row="0" ColumnDefinitions="40,*">
                    <Label Grid.Column="0" 
                           Text="&lt;"
                           FontSize="24"
                           TextColor="#4A90E2"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="1" 
                           Text="Sudoku.com"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Stats Bar -->
                <Grid Grid.Row="1" 
                      ColumnDefinitions="*,*,*,*,Auto" 
                      Margin="0,10,0,15"
                      ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="Difficulty" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                        <Label x:Name="DifficultyLabel" Text="Hard" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1">
                        <Label Text="Mistakes" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                        <Label x:Name="MistakesLabel" Text="0/3" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2">
                        <Label Text="Score" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                        <Label x:Name="ScoreLabel" Text="400" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="3">
                        <Label Text="Time" FontSize="11" TextColor="Gray" HorizontalOptions="Center"/>
                        <Label x:Name="TimeLabel" Text="0:00" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                    <Button Grid.Column="4" 
                           Text="⏸"
                           FontSize="20"
                           BackgroundColor="Transparent"
                           BorderWidth="0"
                           Clicked="OnPauseClicked"
                           Margin="10,0,0,0"/>
                </Grid>

                <!-- Sudoku Grid -->
                <Frame Grid.Row="2"
                       Padding="0"
                       CornerRadius="8"
                       HasShadow="False"
                       BorderColor="Black"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Grid x:Name="SudokuGrid" 
                          WidthRequest="340"
                          HeightRequest="340"
                          MinimumHeightRequest="340"
                          MinimumWidthRequest="340"
                          BackgroundColor="#2F3253">
                        <!-- Grid will be populated in code-behind -->
                    </Grid>
                </Frame>

                <!-- Action Buttons -->
                <Grid Grid.Row="3" 
                      ColumnDefinitions="*,*,*,*" 
                      Margin="0,20,0,10"
                      ColumnSpacing="15">
                    <Button Grid.Column="0" 
                            Text="↺&#10;Undo" 
                            FontSize="20"
                            BackgroundColor="Transparent"
                            TextColor="Gray"
                            BorderWidth="0"
                            Clicked="OnUndoClicked"
                            Padding="2"/>
                    <Button Grid.Column="1" 
                            Text="✏️&#10;Erase" 
                            FontSize="20"
                            BackgroundColor="Transparent"
                            TextColor="Gray"
                            BorderWidth="0"
                            Clicked="OnEraseClicked"
                            Padding="2"/>
                    <Button x:Name="NotesButton"
                            Grid.Column="2" 
                            Text="📝&#10;Notes" 
                            FontSize="20"
                            BackgroundColor="Transparent"
                            TextColor="Gray"
                            BorderWidth="0"
                            Clicked="OnNotesClicked"
                            Pressed="OnNotesPressed"
                            Released="OnNotesReleased"
                            Padding="2"/>
                    <Button Grid.Column="3" 
                            Text="💡&#10;Hint" 
                            TextColor="Gray"
                            FontSize="20"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnHintClicked"
                            Padding="2"/>
                    
                </Grid>

                <!-- Number Pad -->
                <Grid Grid.Row="4" 
                      ColumnDefinitions="*,*,*,*,*,*,*,*,*" 
                      Margin="0,10,0,10"
                      ColumnSpacing="8">
                    <Button Grid.Column="0" 
                            Text="1" 
                            FontSize="28" 
                            TextColor="#B0B0B0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnNumber1Clicked"
                            Pressed="OnNumberPressed"
                            Released="OnNumberReleased"
                            MinimumWidthRequest="30"
                            WidthRequest="30"/>
                    <Button Grid.Column="1" 
                            Text="2" 
                            FontSize="28" 
                            TextColor="#B0B0B0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnNumber2Clicked"
                            Pressed="OnNumberPressed"
                            Released="OnNumberReleased"
                            MinimumWidthRequest="30"
WidthRequest="30"/>
                    <Button Grid.Column="2" 
                            Text="3" 
                            FontSize="28" 
                            TextColor="#B0B0B0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnNumber3Clicked"
                            Pressed="OnNumberPressed"
                            Released="OnNumberReleased"
                            MinimumWidthRequest="30"
WidthRequest="30"/>
                    <Button Grid.Column="3" 
                            Text="4" 
                            FontSize="28" 
                            TextColor="#B0B0B0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnNumber4Clicked"
                            Pressed="OnNumberPressed"
                            Released="OnNumberReleased"
                            MinimumWidthRequest="30"
WidthRequest="30"/>
                    <Button Grid.Column="4" 
                            Text="5" 
                            FontSize="28" 
                            TextColor="#B0B0B0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnNumber5Clicked"
                            Pressed="OnNumberPressed"
                            Released="OnNumberReleased"
                            MinimumWidthRequest="30"
WidthRequest="30"/>
                    <Button Grid.Column="5" 
                            Text="6" 
                            FontSize="28" 
                            TextColor="#B0B0B0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnNumber6Clicked"
                            Pressed="OnNumberPressed"
                            Released="OnNumberReleased"
                            MinimumWidthRequest="30"
WidthRequest="30"/>
                    <Button Grid.Column="6" 
                            Text="7" 
                            FontSize="28" 
                            TextColor="#B0B0B0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnNumber7Clicked"
                            Pressed="OnNumberPressed"
                            Released="OnNumberReleased"
                            MinimumWidthRequest="30"
WidthRequest="30"/>
                    <Button Grid.Column="7" 
                            Text="8" 
                            FontSize="28" 
                            TextColor="#B0B0B0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnNumber8Clicked"
                            Pressed="OnNumberPressed"
                            Released="OnNumberReleased"
                            MinimumWidthRequest="30"
WidthRequest="30"/>
                    <Button Grid.Column="8" 
                            Text="9" 
                            FontSize="28" 
                            TextColor="#B0B0B0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            Clicked="OnNumber9Clicked"
                            Pressed="OnNumberPressed"
                            Released="OnNumberReleased"
                            MinimumWidthRequest="30"
WidthRequest="30"/>
                </Grid>

            </Grid>
        </Frame>

    </Grid>

</ContentPage>
